    let scripts: array<Script> = [
        Script {
            id: "script_001",
            title: "Auto Farm V2",
            description: "Advanced auto-farming script with anti-detection",
            category: "game",
            format: ".lz",
            encryptedPayload: crypto.encrypt("-- Auto Farm Logic", "zurai02-secure-key-v2"),
            ownerId: "system",
            executions: 15420,
            premium: true,
            createdAt: modules.process.time()
        },
        Script {
            id: "script_002",
            title: "ESP & Wallhack",
            description: "See players through walls with customizable ESP",
            category: "utility",
            format: ".lua",
            encryptedPayload: crypto.encrypt("-- ESP Logic", "zurai02-secure-key-v2"),
            ownerId: "system",
            executions: 8932,
            premium: false,
            createdAt: modules.process.time()
        },
        Script {
            id: "script_003",
            title: "Admin Commands",
            description: "Full admin command suite",
            category: "admin",
            format: ".lz",
            encryptedPayload: crypto.encrypt("-- Admin Logic", "zurai02-secure-key-v2"),
            ownerId: "system",
            executions: 6781,
            premium: true,
            createdAt: modules.process.time()
        }
    ]

    for script in scripts {
        db.createScript(script)
    }

    print("Seeded " + scripts.length() + " demo scripts")
}

main()
